{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pickledeals-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5173",
        "--directory",
        "preview"
      ],
      "port": 5173
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "apps/mobile",
      "port": 8081
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@pickledeals/admin",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "admin-hosted",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:hosted",
        "-w",
        "@pickledeals/admin",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "mobile-web-hosted",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "cwd": "apps/mobile",
      "port": 8082,
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://tadxbjlhknukpyxbqrpt.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_gTRmKe2DsjR3g7xmj4XsEA_2EcRyVIw"
      }
    }
  ]
}
