{
  "expo": {
    "name": "PickleDeals",
    "slug": "pickledeals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pickledeals",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.pickledeals",
      "appleTeamId": "ZSH27U747N",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.pickledeals"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#0B0B0C"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PickleDeals uses your approximate area to show nearby listings and to place your listing on the map. Your exact location is never shared."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of the gear you are selling.",
          "cameraPermission": "Take photos of the gear you are selling."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0049f682-0793-4fa5-befc-09736009cbb1"
      }
    },
    "owner": "dhjesus122",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0049f682-0793-4fa5-befc-09736009cbb1"
    }
  }
}
