# Copy to supabase/functions/.env (gitignored) for local runs; set the same names as project
# secrets on staging/production with `supabase secrets set`.
# Sign in with Apple token revocation (delete-account). From developer.apple.com → Keys.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Bundle identifier used for native Sign in with Apple.
APPLE_CLIENT_ID=app.pickledeals
# Contents of the .p8 key, with newlines escaped as \n.
APPLE_PRIVATE_KEY=

# --- Phase 12: automated offer sources (ingest) and affiliate links (go) ---
# Amazon Creators API (Associates Central → Tools → Creators API). Leave unset until approved;
# the amazon-creators source then reports "not configured" instead of running.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
# Your Associates tracking ID, e.g. pickledeals-20 (also the Amazon affiliate tag_template in the admin).
AMAZON_PARTNER_TAG=
# Optional overrides, for the local mock only (node scripts/mock-integrations.mjs):
# AMAZON_CREATORS_TOKEN_URL=http://host.docker.internal:54399/auth/o2/token
# AMAZON_CREATORS_API_URL=http://host.docker.internal:54399/catalog/v1
# Product datafeed download URLs (they usually embed credentials, so they live here, not in the database).
# The source's config.url_env names the variable; only FEED_URL_* names are read.
FEED_URL_AVANTLINK_SELKIRK=
# Local mock: FEED_URL_AVANTLINK_SELKIRK=http://host.docker.internal:54399/feeds/selkirk.tsv
# Optional: affiliate click-URL hosts the go function may redirect through (comma-separated).
# AFFILIATE_LINK_HOSTS=avantlink.com,sjv.io
